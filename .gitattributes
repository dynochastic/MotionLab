*.mp4 filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text

# Tell GitHub to treat all C++ files as external/third-party library code (ignores them in stats)
*.cpp linguist-vendored
*.h linguist-vendored
*.hpp linguist-vendored

# Hide entire auto-generated directories from stats
build/** linguist-generated
unityLibrary/** linguist-generated
