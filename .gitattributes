*.mp4 filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text

# Completely hide all C and C++ source code files from language stats
*.c linguist-vendored
*.cpp linguist-vendored
*.h linguist-vendored
*.hpp linguist-vendored

# Completely ignore the entire auto-generated Unity directory structure
unityLibrary/** linguist-vendored
build/** linguist-vendored
